{
  "name": "apps-download-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Presentyourlove Apps Download Center",
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "dev": "browser-sync start --server --files '**/*'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "minify:css": "csso css/style.css --output css/style.min.css",
    "minify:js": "terser js/script.js --output js/script.min.js",
    "docker:build": "docker build -t apps-download-web .",
    "docker:run": "docker run -p 8080:80 apps-download-web",
    "prepare": "husky install",
    "convert:images": "node scripts/convert-images.js",
    "generate:critical": "node scripts/generate-critical.mjs",
    "generate:critical:inline": "node scripts/generate-critical.mjs --inline",
    "serve:csp": "node server/csp-server.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/html-vite": "^10.1.11",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^1.6.0",
    "body-parser": "^2.2.2",
    "browser-sync": "^3.0.4",
    "cors": "^2.8.5",
    "critical": "^7.2.1",
    "csso-cli": "^4.0.2",
    "eslint": "^8.56.0",
    "eslint-plugin-storybook": "^10.1.11",
    "express": "^5.2.1",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "lighthouse": "^11.4.0",
    "lint-staged": "^15.2.0",
    "playwright": "^1.57.0",
    "prettier": "^3.1.1",
    "sharp": "^0.34.5",
    "storybook": "^10.1.11",
    "terser": "^5.26.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "license": "MIT"
}