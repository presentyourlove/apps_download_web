{
  "name": "apps-download-web",
  "version": "2.0.0",
  "private": true,
  "description": "Presentyourlove Apps Download Center",
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "minify:css": "csso css/style.css --output css/style.min.css",
    "minify:js": "terser js/script.js --output js/script.min.js",
    "docker:build": "docker build -t apps-download-web .",
    "docker:run": "docker run -p 8080:80 apps-download-web",
    "prepare": "husky install",
    "convert:images": "node scripts/convert-images.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.0.0",
    "csso-cli": "^4.0.2",
    "eslint": "^8.56.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^11.4.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "sharp": "^0.34.5",
    "terser": "^5.26.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "license": "MIT"
}