---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import InstallPrompt from '../components/pwa/InstallPrompt.astro';
import ReloadPrompt from '../components/pwa/ReloadPrompt.astro';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl } from '../i18n/utils';

// Self-hosted Fonts
// Inter Variable Font (contains weights 100-900)
import '@fontsource-variable/inter';
import '@fontsource/noto-sans-tc/400.css';
import '@fontsource/noto-sans-tc/500.css';
import '@fontsource/noto-sans-tc/700.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Presentyourlove 應用程式下載中心',
  ogImage = '/assets/presentyourlove-logo-512.webp',
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Security -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Presentyourlove" />
    <meta name="robots" content="index, follow" />

    <ClientRouter />

    <!-- SEO -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="Presentyourlove" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- PWA -->
    <link rel="manifest" href={`${import.meta.env.BASE_URL}/manifest.json`} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Icons -->
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}/assets/presentyourlove-logo-32.webp`}
      type="image/webp"
    />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}/assets/presentyourlove-logo-32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}/assets/presentyourlove-logo-192.png`}
    />

    <!-- Fonts (Self-hosted via @fontsource) -->

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'Presentyourlove',
        url: Astro.site?.toString() || 'https://presentyourlove.github.io/apps_download_web_v3/',
        description: description,
        publisher: {
          '@type': 'Organization',
          name: 'Presentyourlove',
          logo: {
            '@type': 'ImageObject',
            url: ogImageURL.toString(),
          },
        },
      })}
    />
    <script is:inline>
      // FART Prevention: Init theme before paint
      (function () {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="skip-link">跳至主要內容</a>

    <Header />

    <main
      id="main-content"
      data-pagefind-body
      style="padding-top: 80px; min-height: 100vh; display: flex; flex-direction: column;"
    >
      <div style="flex: 1;">
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      // Theme Logic for View Transitions (Re-run on navigation)
      function initTheme() {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      }

      // Re-initialize after swapping pages
      document.addEventListener('astro:after-swap', initTheme);
    </script>
    <Analytics />
    <InstallPrompt />
    <ReloadPrompt />

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        background: var(--bg-color, #0f172a);
        color: var(--text-primary, #f8fafc);
        padding: 0.5rem 1rem;
        z-index: 9999;
        text-decoration: none;
        border-radius: 0 0 0.5rem 0;
        font-weight: 500;
        transition: top 0.2s ease-in-out;
      }

      .skip-link:focus {
        top: 0;
        outline: 2px solid var(--accent-color, #6366f1);
      }
    </style>
  </body>
</html>
