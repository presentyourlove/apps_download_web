---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} - Blog`}>
  <article class="post-detail">
    {post.data.heroImage && (
      <div class="post-hero">
        <img src={post.data.heroImage} alt={post.data.title} />
      </div>
    )}
    
    <div class="container mobile-container">
      <div class="post-header">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-TW', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <div class="post-tags">
            {post.data.tags && post.data.tags.map(tag => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
      </div>

      <div class="post-content glass-effect">
        <Content />
      </div>

      <div class="post-footer">
        <a href={`${import.meta.env.BASE_URL}/blog/`} class="back-link">
          ← 返回部落格列表
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* 文章內容樣式 */
  .post-content {
    line-height: 1.8;
    font-size: 1.1rem;
    color: var(--text-primary);
  }

  .post-content h2 {
    margin: 40px 0 20px;
    font-size: 1.75rem;
    border-bottom: 2px solid rgba(var(--accent-rgb), 0.2);
    padding-bottom: 8px;
  }

  .post-content h3 {
    margin: 30px 0 15px;
    font-size: 1.5rem;
  }

  .post-content p {
    margin-bottom: 20px;
  }

  .post-content ul, .post-content ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .post-content li {
    margin-bottom: 8px;
  }

  .post-content img {
    max-width: 100%;
    border-radius: 12px;
    margin: 32px 0;
  }
  
  .post-content blockquote {
    border-left: 4px solid var(--accent-color);
    padding: 16px 24px;
    margin: 32px 0;
    background: rgba(var(--accent-rgb), 0.05);
    border-radius: 0 12px 12px 0;
    font-style: italic;
  }
</style>

<style>
  .post-detail {
    padding-top: 100px;
    padding-bottom: 60px;
  }

  .post-hero {
    width: 100%;
    height: 40vh;
    min-height: 300px;
    margin-bottom: 40px;
  }

  .post-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mobile-container {
    max-width: 800px;
  }

  .post-header {
    margin-bottom: 40px;
    text-align: center;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    color: var(--text-secondary);
  }

  .post-tags {
    display: flex;
    gap: 8px;
  }

  .blog-tag {
    background: rgba(var(--accent-rgb), 0.1);
    color: var(--accent-color);
    padding: 2px 10px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .post-title {
    font-size: 3rem;
    line-height: 1.2;
    font-weight: 800;
  }

  .post-content {
    background: var(--card-bg);
    border: var(--glass-border);
    backdrop-filter: blur(12px);
    padding: 48px;
    border-radius: 32px;
  }

  .post-footer {
    margin-top: 60px;
    text-align: center;
  }

  .back-link {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: transform 0.2s;
    display: inline-block;
  }

  .back-link:hover {
    transform: translateX(-5px);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 2rem;
    }
    
    .post-content {
      padding: 24px;
    }
  }
</style>
