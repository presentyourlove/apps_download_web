import { getCollection } from 'astro:content';
import AppDetailsPage from '@/components/pages/AppDetailsPage.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps
    .filter((app) => app.id.startsWith('zh-TW/'))
    .map((app) => ({
      params: { appId: app.data.id },
      props: { app: { ...app.data, _id: app.id } },
    }));
}

const { app } = Astro.props;
---

<AppDetailsPage app={app} lang="zh-TW" />
