---
/* Search.astro - Command Palette & Search */
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { App } from '../lib/data';

interface Props {
  apps?: App[];
}

const { apps = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// 預先產生導航路徑供 Client-side 使用
const navPaths = {
  home: translatePath('/'),
  blog: translatePath('/blog/'),
  about: translatePath('/about/'),
};

const appPaths = apps.map((app) => ({
  id: app.id,
  name: app.displayName,
  path: translatePath(`/${app.id}/`),
}));
---

<div class="search-container">
  <button
    id="search-trigger"
    class="search-btn"
    aria-label={t('search.trigger')}
    title={`${t('search.trigger')} (Ctrl+K)`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="feather feather-search"
      ><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"
      ></line></svg
    >
    <span class="search-text">{t('search.trigger')}</span>
    <kbd class="search-shortcut">⌘K</kbd>
  </button>

  <div
    id="search-modal"
    class="search-modal"
    aria-hidden="true"
    role="dialog"
    aria-labelledby="search-input"
    data-empty={t('search.placeholder')}
    data-loading="Searching..."
    data-no-results="No results found"
    data-nav-paths={JSON.stringify(navPaths)}
    data-app-paths={JSON.stringify(appPaths)}
  >
    <div class="search-modal-overlay"></div>
    <div class="search-modal-content">
      <div class="search-header">
        <svg
          class="search-icon"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="search-input"
          placeholder="Search commands and files..."
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="esc-hint">ESC</kbd>
      </div>

      <div id="search-results" class="search-results">
        <!-- Results will be injected here -->
      </div>

      <div class="search-footer">
        <div class="footer-hint">
          <kbd>↑</kbd>
          <kbd>↓</kbd> to navigate
        </div>
        <div class="footer-hint">
          <kbd>↵</kbd> to select
        </div>
        <div class="footer-powered">
          Powered by <strong>Pagefind</strong>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .search-container {
    display: inline-block;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 12px;
    border-radius: 12px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .search-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--accent-color);
    color: var(--text-primary);
  }

  .search-text {
    font-size: 0.9rem;
  }

  .search-shortcut {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
  }

  /* Modal Styles */
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s;
  }

  .search-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .search-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .search-modal-content {
    position: relative;
    width: 90%;
    max-width: 600px;
    background: var(--bg-secondary);
    border: var(--glass-border);
    border-radius: 16px;
    box-shadow: 0 50px 100px -20px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    max-height: 70vh;
    transform: scale(0.98);
    transition:
      opacity 0.2s,
      transform 0.2s;
    opacity: 0;
    overflow: hidden;
  }

  .search-modal.active .search-modal-content {
    transform: scale(1);
    opacity: 1;
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    gap: 12px;
  }

  .search-icon {
    color: var(--text-secondary);
  }

  #search-input {
    flex: 1;
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.1rem;
    outline: none;
    padding: 0;
  }

  .esc-hint {
    font-size: 0.7rem;
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text-secondary);
  }

  .search-results {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    scroll-behavior: smooth;
  }

  .search-empty {
    text-align: center;
    color: var(--text-secondary);
    padding: 40px 0;
  }

  /* Group Titles */
  :global(.search-group-title) {
    font-size: 0.75rem;
    color: var(--text-secondary);
    padding: 8px 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    margin-top: 8px;
  }
  :global(.search-group-title:first-child) {
    margin-top: 0;
  }

  /* Result Items */
  :global(.result-item) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 8px;
    border-left: 2px solid transparent;
    cursor: pointer;
    color: var(--text-primary);
    text-decoration: none;
    transition: background 0.1s;
  }

  :global(.result-item.selected),
  :global(.result-item:hover) {
    background: rgba(255, 255, 255, 0.05);
  }

  :global(.result-item.selected) {
    border-left-color: var(--accent-color);
  }

  :global(.result-icon) {
    color: var(--text-secondary);
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.result-item.selected .result-icon) {
    color: var(--accent-color);
  }

  :global(.result-content) {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  :global(.result-title) {
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.result-desc) {
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }

  :global(mark) {
    background: transparent;
    color: var(--accent-color);
    font-weight: 700;
    padding: 0;
  }

  .search-footer {
    display: flex;
    justify-content: space-between;
    padding: 12px 20px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .footer-hint {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .footer-hint kbd {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 5px;
    border-radius: 4px;
    font-size: 0.7rem;
    min-width: 18px;
    text-align: center;
  }

  @media (max-width: 600px) {
    .search-text,
    .search-shortcut,
    .search-footer {
      display: none;
    }
    .search-btn {
      padding: 8px;
    }
    .search-modal-content {
      width: 100%;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
    }
    .search-modal {
      padding-top: 0;
    }
  }
</style>

<script>
  // Lazy Load Search Logic
  // Only import the heavy controller when the user actually wants to search
  import type { SearchController as SearchControllerType } from '../lib/search';

  let controller: SearchControllerType | null = null;
  let isLoading = false;

  const trigger = document.getElementById('search-trigger');

  async function loadAndOpenSearch() {
    if (isLoading) return;

    if (!controller) {
      isLoading = true;
      try {
        // Dynamic import
        const { SearchController } = await import('../lib/search');
        controller = new SearchController();
      } catch (e) {
        console.error('Failed to load search module:', e);
        isLoading = false;
        return;
      } finally {
        isLoading = false;
      }
    }

    controller?.openModal();
  }

  // Click Trigger
  trigger?.addEventListener('click', (e) => {
    e.preventDefault();
    loadAndOpenSearch();
  });

  // Keyboard Shortcut (Cmd+K / Ctrl+K)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      loadAndOpenSearch();
    }
  });

  // View Transitions Clean up (optional, but good practice)
  document.addEventListener(
    'astro:before-preparation',
    () => {
      // If we needed to destroy the controller, we would do it here.
      // Since it's a singleton-like behavior attached to DOM, we let new page load handle it?
      // Actually, Astro View Transitions might re-run script, creating new listeners.
      // But since elements are replaced, listeners on elements are gone.
      // Window listener needs cleanup though.
    },
    { once: true }
  );
</script>
