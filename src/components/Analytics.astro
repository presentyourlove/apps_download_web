---
import { PUBLIC_ANALYTICS_ID, PUBLIC_ANALYTICS_SCRIPT_URL } from 'astro:env/client';

const analyticsId = PUBLIC_ANALYTICS_ID;
const analyticsUrl = PUBLIC_ANALYTICS_SCRIPT_URL;

const shouldRender = !!(analyticsId && analyticsUrl);
---

{shouldRender && (
  <script
    type="text/partytown"
    defer
    src={analyticsUrl}
    data-website-id={analyticsId}
  />
)}
