---
const analyticsId = import.meta.env.PUBLIC_ANALYTICS_ID;
const analyticsUrl = import.meta.env.PUBLIC_ANALYTICS_SCRIPT_URL; // e.g. "https://analytics.example.com/script.js"

const shouldRender = !!(analyticsId && analyticsUrl);
---

{
  shouldRender && (
    <script
      defer
      src={analyticsUrl}
      data-website-id={analyticsId}
    ></script>
  )
}
