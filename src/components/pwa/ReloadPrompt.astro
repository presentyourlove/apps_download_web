<script>
  import { registerSW } from 'virtual:pwa-register';

  const updateSW = registerSW({
    onNeedRefresh() {
      const toast = document.getElementById('pwa-toast');
      const msg = document.getElementById('pwa-toast-message');
      if (toast && msg) {
        msg.textContent = '發現新版本，請更新以獲取最佳體驗。';
        toast.classList.add('show');
      }
    },
    onOfflineReady() {
      // App ready for offline usage
    },
  });

  const closeBtn = document.getElementById('pwa-close-btn');
  const updateBtn = document.getElementById('pwa-update-btn');

  closeBtn?.addEventListener('click', () => {
    document.getElementById('pwa-toast')?.classList.remove('show');
  });

  updateBtn?.addEventListener('click', () => {
    updateSW(true);
  });
</script>

<div id="pwa-toast" class="toast-notification" role="alert">
  <div class="toast-icon">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
  </div>
  <div class="toast-content">
    <span id="pwa-toast-message">有新版本可用</span>
  </div>
  <div class="toast-actions">
    <button id="pwa-update-btn" class="btn-text">更新</button>
    <button id="pwa-close-btn" class="btn-icon" aria-label="Close">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
</div>

