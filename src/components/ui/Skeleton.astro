---
interface Props {
  width?: string;
  height?: string;
  borderRadius?: string;
  className?: string;
}

const { width = '100%', height = '1rem', borderRadius = '4px', className = '' } = Astro.props;
---

<div class:list={['skeleton', className]} style={{ width, height, borderRadius }}></div>

<style>
  .skeleton {
    background-color: var(--bg-secondary);
    background-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0,
      rgba(255, 255, 255, 0.05) 20%,
      rgba(255, 255, 255, 0.1) 60%,
      rgba(255, 255, 255, 0)
    );
    background-size: 200% 100%;
    animation: shimmer 2s infinite linear;
  }
</style>
