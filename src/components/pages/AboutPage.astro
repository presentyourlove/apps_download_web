---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, useTranslatedPath } from '@/i18n/utils';

interface Props {
  lang: 'zh-TW' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout
  title={`${t('about.title')} | Presentyourlove`}
  description={t('about.bio').replace(/<br \/>/g, ' ')}
>
  <div class="links-container">
    <!-- Profile Section -->
    <section class="profile-section">
      <img
        src={`${import.meta.env.BASE_URL}/assets/presentyourlove-logo-192.webp`}
        alt="Presentyourlove"
        class="profile-img"
        width="120"
        height="120"
      />
      <h1 class="profile-title">Presentyourlove</h1>
      <p class="profile-bio" set:html={t('about.bio')} />
    </section>

    <!-- Links Stack -->
    <div class="links-stack">
      <!-- Home / App Center -->
      <a href={translatePath('/')} class="link-btn">
        <div class="link-content">
          <div class="link-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </div>
          <span>{t('about.appCenter')}</span>
        </div>
        <div class="link-arrow">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>

      <!-- Facebook -->
      <a
        href="https://facebook.com/presentyourlove"
        target="_blank"
        rel="noopener noreferrer"
        class="link-btn"
      >
        <div class="link-content">
          <div class="link-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </div>
          <span>{t('about.facebook')}</span>
        </div>
        <div class="link-arrow">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>

      <!-- Instagram -->
      <a
        href="https://instagram.com/presentyourlove"
        target="_blank"
        rel="noopener noreferrer"
        class="link-btn"
      >
        <div class="link-content">
          <div class="link-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
          <span>Instagram</span>
        </div>
        <div class="link-arrow">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>

      <!-- Youtube -->
      <a
        href="https://www.youtube.com/@presentyourlove"
        target="_blank"
        rel="noopener noreferrer"
        class="link-btn"
      >
        <div class="link-content">
          <div class="link-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"
              ></path>
              <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
            </svg>
          </div>
          <span>Youtube</span>
        </div>
        <div class="link-arrow">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>

      <!-- Email -->
      <a href="mailto:presentyourlove@yahoo.com" class="link-btn">
        <div class="link-content">
          <div class="link-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <span>{t('about.contact')}</span>
        </div>
        <div class="link-arrow">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .links-container {
    padding-top: 40px;
    padding-bottom: 60px;
    min-height: calc(100vh - 160px);
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
    padding-left: 20px;
    padding-right: 20px;
  }

  .profile-section {
    text-align: center;
    margin-bottom: 48px;
    width: 100%;
  }

  .profile-img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin-bottom: 24px;
    border: 4px solid var(--accent-color);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.2);
    object-fit: cover;
  }

  .profile-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-color) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .profile-bio {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 90%;
    margin: 0 auto 24px;
  }

  .links-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .link-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 16px 24px;
    background: var(--card-bg);
    border: var(--glass-border);
    border-radius: 50px;
    color: var(--text-primary);
    text-decoration: none;
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-color) 0 4px 6px;
    transition: all 0.3s ease;
  }

  .link-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(var(--accent-rgb), 0.2);
    border-color: var(--accent-color);
  }

  .link-content {
    display: flex;
    align-items: center;
    gap: 16px;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--accent-color);
  }

  .link-icon svg {
    width: 28px;
    height: 28px;
  }

  .link-arrow {
    color: var(--text-secondary);
    opacity: 0.5;
    transition: transform 0.3s ease;
  }

  .link-btn:hover .link-arrow {
    transform: translateX(4px);
    opacity: 1;
  }
</style>
