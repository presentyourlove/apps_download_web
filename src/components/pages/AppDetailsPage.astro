---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPlatformsArray, type App } from '@/lib/data';
import { useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  app: App;
  lang: 'zh-TW' | 'en';
}

const { app, lang } = Astro.props;
const platforms = getPlatformsArray(app);
const t = useTranslations(lang);

// 動態匯入圖示
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/icons/*.{png,jpg,jpeg,webp}'
);
const imagePath = `/src/assets/icons/${app.id}-icon-192.png`;

if (!images[imagePath]) {
  throw new Error(
    `"${imagePath}" does not exist in glob: "/src/assets/icons/*.{png,jpg,jpeg,webp}"`
  );
}

// 檢查是否有 iOS 版本 (用於顯示 AltStore 說明)
const hasIOS = app.platforms?.ios !== undefined;
const showAltStoreGuide = hasIOS;
---

<BaseLayout
  title={`${app.displayName} - ${t('app.download')} | Presentyourlove`}
  description={`${t('app.download')} ${app.displayName} v${app.version}`}
  ogImage={`${import.meta.env.BASE_URL}/open-graph/${app.id}.png`}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: app.name,
        operatingSystem: Object.keys(app.platforms)
          .map((p) => (p === 'android' ? 'Android' : p === 'ios' ? 'iOS' : 'Web'))
          .join(', '),
        applicationCategory: 'FinanceApplication', // 範例類別
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
        softwareVersion: app.version,
        datePublished: app.releaseDate,
        author: {
          '@type': 'Organization',
          name: 'Presentyourlove',
          url: 'https://presentyourlove.github.io/',
        },
        downloadUrl: app.platforms.android?.downloadUrl || '',
      })}
    />
  </Fragment>
  <article class="app-detail">
    <div class="container">
      <header class="app-header">
        <Image
          src={images[imagePath]()}
          alt={`${app.name} Icon`}
          width={120}
          height={120}
          densities={[1, 1.5, 2]}
          class="app-icon"
        />
        <div class="app-info">
          <h1>{app.displayName}</h1>
          <p class="version">{t('app.version')} {app.version}</p>
          <p class="release-date">{t('app.releaseDate')}: {app.releaseDate}</p>
        </div>
      </header>

      <section class="platforms-section">
        <h2>{t('app.platforms')}</h2>
        <div class="platform-grid">
          {
            platforms.map((platform) => (
              <div
                class={`platform-card ${platform.status === 'coming_soon' ? 'coming-soon' : ''}`}
              >
                <h3>
                  {platform.type === 'android' && 'Android'}
                  {platform.type === 'ios' && 'iOS'}
                  {platform.type === 'web' && 'Web App'}
                </h3>

                {/* 版本資訊 */}
                <p class="platform-version">
                  {t('app.version')}: {platform.version}
                </p>
                {platform.minOS && <p class="platform-req">Minimum OS: iOS {platform.minOS}</p>}
                {platform.minSdk && (
                  <p class="platform-req">Minimum SDK: Android API {platform.minSdk}</p>
                )}
                {platform.size && <p class="platform-size">Size: {platform.size}</p>}

                {/* iOS 即將上架提示 */}
                {platform.status === 'coming_soon' && (
                  <div class="coming-soon-badge">
                    <span class="badge-icon">📅</span>
                    <span>Coming Soon (March 2026)</span>
                  </div>
                )}

                {/* AltStore 即將上架提示 */}
                {platform.altstore?.status === 'coming_soon' && (
                  <div class="coming-soon-badge altstore-badge">
                    <span class="badge-icon">🔧</span>
                    <span>AltStore Version Coming Soon</span>
                  </div>
                )}

                {/* 開啟 Deep Link 按鈕 */}
                {app.scheme && platform.type !== 'web' && (
                  <a href={app.scheme} class="btn btn-primary">
                    {t('app.openApp')}
                  </a>
                )}

                {/* 下載按鈕 */}
                {platform.downloadUrl && (
                  <a href={platform.downloadUrl} class="btn btn-primary" download>
                    {t('app.download')}
                  </a>
                )}

                {platform.storeUrl && (
                  <a
                    href={platform.storeUrl}
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t('app.goStore')}
                  </a>
                )}

                {platform.url && platform.type === 'web' && (
                  <a
                    href={platform.url}
                    class="btn btn-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t('app.openWeb')}
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </section>

      {/* AltStore 安裝說明 - 只在有 iOS 版本時顯示 */}
      {
        showAltStoreGuide && (
          <section class="guide-section">
            <h2>{t('guide.title')}</h2>
            <div class="guide-steps">
              <div class="step-card">
                <div class="step-number">1</div>
                <h3>{t('guide.step1.title')}</h3>
                <p>{t('guide.step1.desc')}</p>
                <a
                  href="https://altstore.io/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                >
                  AltStore Website ↗
                </a>
              </div>
              <div class="step-card">
                <div class="step-number">2</div>
                <h3>{t('guide.step2.title')}</h3>
                <p>{t('guide.step2.desc')}</p>
              </div>
              <div class="step-card">
                <div class="step-number">3</div>
                <h3>{t('guide.step3.title')}</h3>
                <p>{t('guide.step3.desc')}</p>
              </div>
            </div>
          </section>
        )
      }

      <section class="changelog-section">
        <h2>{t('app.changelog')}</h2>
        {
          app.changelog.map((entry) => (
            <div class="changelog-entry">
              <h3>
                v{entry.version} <span class="changelog-date">({entry.date})</span>
              </h3>
              <ul>
                {entry.changes.map((change) => (
                  <li>{change}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .app-detail {
    padding: 60px 0 80px;
    min-height: 100vh;
  }

  .app-header {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-bottom: 60px;
    padding-bottom: 40px;
    border-bottom: var(--glass-border);
  }

  .app-icon {
    border-radius: 24px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  .app-info h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .version {
    font-size: 1.1rem;
    color: var(--accent-color);
    font-weight: 600;
  }

  .release-date {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-top: 4px;
  }

  .platforms-section,
  .changelog-section,
  .guide-section {
    margin-bottom: 60px;
  }

  .platforms-section h2,
  .changelog-section h2,
  .guide-section h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 32px;
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .platform-card {
    background: var(--card-bg);
    border: var(--glass-border);
    backdrop-filter: blur(12px);
    padding: 32px;
    border-radius: 20px;
    transition: all 0.3s ease;
  }

  .platform-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 40px rgba(var(--accent-rgb), 0.2);
    border-color: var(--accent-color);
  }

  .platform-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .platform-version,
  .platform-req,
  .platform-size {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }

  .platform-card .btn {
    margin-top: 16px;
    width: 100%;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .platform-card .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(var(--accent-rgb), 0.3);
  }

  .platform-card .btn:active {
    transform: translateY(0);
  }

  /* Shimmer Effect */
  .platform-card .btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 200%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transform: skewX(-15deg);
    transition: 0.5s;
  }

  .platform-card .btn:hover::after {
    left: 100%;
    transition: 0.7s ease-in-out;
  }

  /* Coming Soon Badge */
  .coming-soon-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 12px 16px;
    background: rgba(var(--accent-rgb), 0.1);
    border: 1px solid rgba(var(--accent-rgb), 0.3);
    border-radius: 12px;
    font-size: 0.9rem;
    color: var(--accent-color);
  }

  .badge-icon {
    font-size: 1.2rem;
  }

  .altstore-badge {
    margin-top: 12px;
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.3);
  }

  /* Guide Section */
  .guide-section {
    margin-top: 20px;
  }

  .guide-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .guide-steps {
      grid-template-columns: 1fr;
    }
  }

  .step-card {
    background: var(--bg-secondary);
    padding: 32px 24px 28px;
    border-radius: 16px;
    border: var(--glass-border);
    position: relative;
    margin-top: 16px;
    overflow: visible;
  }

  .step-number {
    position: absolute;
    top: -16px;
    left: 24px;
    width: 32px;
    height: 32px;
    background: var(--accent-color);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    z-index: 1;
  }

  .step-card h3 {
    font-size: 1.1rem;
    margin-bottom: 12px;
    margin-top: 4px;
    font-weight: 600;
  }

  .step-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  .text-link {
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 500;
    margin-top: 16px;
    display: inline-block;
    transition: opacity 0.2s;
  }

  .text-link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* Changelog */
  .changelog-entry {
    background: var(--card-bg);
    border: var(--glass-border);
    backdrop-filter: blur(12px);
    padding: 32px;
    border-radius: 16px;
    margin-bottom: 24px;
  }

  .changelog-entry h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--accent-color);
  }

  .changelog-date {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 400;
  }

  .changelog-entry ul {
    list-style: none;
    padding: 0;
  }

  .changelog-entry li {
    padding: 8px 0;
    padding-left: 24px;
    position: relative;
    color: var(--text-secondary);
  }

  .changelog-entry li::before {
    content: '•';
    position: absolute;
    left: 8px;
    color: var(--accent-color);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .app-header {
      flex-direction: column;
      text-align: center;
      gap: 24px;
    }

    .app-info h1 {
      font-size: 2rem;
    }

    .platforms-section h2,
    .changelog-section h2,
    .guide-section h2 {
      font-size: 1.5rem;
    }
  }
</style>
